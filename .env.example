# Copy this file to .env and fill in your own keys. Never commit .env itself.
# Everything except the first three has a sensible default for running on your own machine.

# --- Required ------------------------------------------------------------------------------------
# Google AI (Gemini) key from https://aistudio.google.com/apikey
GOOGLE_API_KEY=
# Serper.dev key for job search (2,500 free searches a month)
SERPER_API_KEY=
# Signs login tokens. Use a long random value, at least 32 characters:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=

# --- Mode ----------------------------------------------------------------------------------------
# local (your machine) or production (the hosted demo)
APP_ENV=local
# true = real browser automation: Playwright searches, job-board sign-in, auto-apply.
# Needs requirements-automation.txt and Chromium (docker compose sets this for you).
# false = the public demo: no browser, auto-apply becomes a dry run, daily quotas apply.
ENABLE_BROWSER_AUTOMATION=false

# --- Database ------------------------------------------------------------------------------------
# Empty = SQLite at data/jobfinder.db. For Postgres (Neon, Supabase):
#   DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=

# --- CV storage ----------------------------------------------------------------------------------
# local = files in UPLOAD_DIR; s3 = a private S3-compatible bucket (Cloudflare R2, Supabase Storage)
STORAGE_BACKEND=local
UPLOAD_DIR=uploads
S3_BUCKET=
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto

# --- Cookies -------------------------------------------------------------------------------------
# Leave true in production. Set false only for plain-http local runs in Safari.
COOKIE_SECURE=true

# --- Public demo protections (production) ----------------------------------------------------------
# Shared with the Cloudflare Pages proxy; when set, the API only answers requests sent through it.
PROXY_SHARED_SECRET=
# Shared with the daily GitHub Actions cleanup job.
CLEANUP_SECRET=
# Cloudflare Turnstile ("I'm human" check). Empty = no check.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Limits (defaults shown)
USER_DAILY_AGENT_RUNS=10
GLOBAL_DAILY_AGENT_RUNS=60
GLOBAL_DAILY_SERPER_CALLS=80
GUEST_TTL_HOURS=24
DATA_RETENTION_DAYS=30

# --- Optional ------------------------------------------------------------------------------------
# Sentry error tracking (backend and browser DSNs; the browser one is public by design)
SENTRY_DSN=
SENTRY_FRONTEND_DSN=
# Link to the auto-apply demo video, shown next to the dry run
DEMO_VIDEO_URL=

# Docker only, optional: password for the live browser view at http://localhost:6080.
VNC_PASSWORD=
